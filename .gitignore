wp-config.php
wp-config-sample.php

# Database
*.sql
*.sql.gz

# Logs
*.log
error_log
debug.log

# OS Files
.DS_Store
Thumbs.db
desktop.ini

# IDE Files
.vscode/
.idea/
*.swp
*.swo
*~

# Node modules (if any WordPress plugins use npm)
node_modules/
package-lock.json

# Environment files
.env
.env.*

# Temporary files
*.tmp
*.temp
*.bak
*.cache

# Theme build artifacts (we want to keep dist/ for production)
